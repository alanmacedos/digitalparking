    {
      "id": "text-77",
      "type": "text",
      "x": 96,
      "y": 1413,
      "width": 652.5,
      "height": 75,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
